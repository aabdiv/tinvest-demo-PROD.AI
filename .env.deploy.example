# Copy to .env.deploy on the SERVER; never commit that file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=qwen/qwen3.8-27b
SMART_MODEL=moonshotai/kimi-k2.6
FAST_PROVIDER_SORT=throughput
DISABLE_REASONING=1
# 0: require a real key. 1: explicitly run without LLM calls.
MOCK_LLM=0

DEMO_USER=demo
# Keep single quotes around the bcrypt hash so Compose preserves dollar signs.
# Generate it interactively: docker run --rm -it caddy:2-alpine caddy hash-password
DEMO_PASSWORD_HASH=''
# Needed only for compose.public.yaml; bare hostname, no scheme or path.
DEMO_DOMAIN=
