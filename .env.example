# Ключ OpenRouter: https://openrouter.ai/keys  (без ключа приложение работает в тестовом режиме на правилах)
OPENROUTER_API_KEY=

# Быстрая ступень: разбор пожеланий, мандат, объяснения, поиск по теме. Важна скорость генерации.
FAST_MODEL=qwen/qwen3.8-27b
# Альтернативы: openai/gpt-oss-120b (дешевле и быстрее, русский слабее), google/gemini-3.6-flash (надёжнее, дороже)
# Умная ступень: разметка карточек бумаг при сборке базы. Скорость не важна.
SMART_MODEL=moonshotai/kimi-k2.6

# Как OpenRouter выбирает провайдера для быстрой ступени: throughput | latency | price | (пусто)
FAST_PROVIDER_SORT=throughput
# 1 — просить модель не рассуждать перед ответом (быстрее). Если провайдер не умеет, запрос повторится без этого.
DISABLE_REASONING=1

# MOCK_LLM=1 — принудительно включить тестовый режим даже с ключом
# UNIVERSE_PATH=tests/universe.fake.json — запустить на синтетических бумагах

# Локальный кабинет: SQLite с портфелями, профилями и историей чата.
# ACCOUNT_DB_PATH=data/account.sqlite3
